# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# AgentID (https://auth.agentid.com). `npx @agentmail/agentid-cli init` writes
# the client id and secret to .env.local after the repo owner approves in the browser.
# Placeholder values are ignored. Never commit real secrets.
AGENTID_CLIENT_ID="YOUR_AGENTID_CLIENT_ID"
AGENTID_CLIENT_SECRET="YOUR_AGENTID_CLIENT_SECRET"
# Optional. Exact redirect URI registered with the AgentID application.
# When unset, the server uses ${APP_URL}/api/auth/agentid/callback, or the request origin.
# Local dev: http://localhost:3000/api/auth/agentid/callback
# AGENTID_REDIRECT_URI="http://localhost:3000/api/auth/agentid/callback"
# Space-delimited scopes sent on every authorize request. Default: openid email profile.
# owner_profile and owner_email require a registered client (a client secret).
# AGENTID_SCOPES="openid email profile"
# Token endpoint auth. Registered clients default to client_secret_basic.
# AGENTID_CLIENT_AUTH="client_secret_basic"
